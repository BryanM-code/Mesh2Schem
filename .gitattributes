# Source and docs: LF in the repository, native line endings on checkout.
*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Never treat Minecraft files, meshes or images as text.
*.schem     binary
*.schematic binary
*.litematic binary
*.glb       binary
*.png       binary
*.jpg       binary
